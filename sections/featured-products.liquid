<section class="featured-products">
  {%- if section.settings.bg_image != blank -%}{%- assign bg = section.settings.bg_image | image_url: width: 2000 -%}{%- else -%}{%- assign bg = 'home-hero.jpg' | asset_url -%}{%- endif -%}
  {%- if section.settings.image != blank -%}{%- assign img = section.settings.image | image_url: width: 800 -%}{%- else -%}{%- assign img = 'overlay-granati.jpg' | asset_url -%}{%- endif -%}
  {%- render 'band', title: section.settings.title, text: section.settings.subtitle, bg: bg, img: img, side: section.settings.image_side, alt: section.settings.title -%}

  <div class="container featured-products__products">

    {%- assign collection = collections[section.settings.collection] -%}
    {%- if collection != blank and collection.products_count > 0 -%}
      <div class="product-grid">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <!-- Fallback: show all products -->
      <div class="product-grid">
        {%- for product in collections.all.products limit: section.settings.products_to_show -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.show_cta -%}
      <div class="text-center mt-3">
        <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn btn--outline">
          {{ section.settings.cta_label | default: 'Vedi tutti i prodotti' }}
        </a>
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Featured Products",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Immagine sovrapposta (se vuota usa quella del tema)"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Sfondo (se vuoto usa quello del tema)"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Lato dell'immagine",
      "default": "left",
      "options": [ { "value": "left", "label": "Sinistra" }, { "value": "right", "label": "Destra" } ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Spiriti preziosi"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "default": "La nostra collezione"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sottotitolo",
      "default": "Ogni prodotto nasce da una varietà di granato: tonalità uniche che guidano aromi, carattere e identità."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collezione da mostrare"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Numero prodotti",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Mostra pulsante 'Vedi tutti'",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Testo pulsante",
      "default": "Vedi tutti i prodotti"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Link pulsante"
    }
  ],
  "presets": [
    {
      "name": "Featured Products"
    }
  ]
}
{% endschema %}
