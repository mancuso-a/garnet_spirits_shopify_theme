<div class="drinks-hero">
  <p class="eyebrow">Miscelazione</p>
  <h1>{{ section.settings.title }}</h1>
  <p>{{ section.settings.subtitle }}</p>
</div>

{%- comment -%} I filtri nascono dai tag scritti nei cocktail: nuovo prodotto = nuovo tag, nessuna modifica al tema. {%- endcomment -%}
{%- assign all_tags = '' -%}
{%- for block in section.blocks -%}
  {%- assign block_tags = block.settings.tags | split: ',' -%}
  {%- for t in block_tags -%}
    {%- assign tt = t | strip -%}
    {%- if tt != blank -%}{%- assign all_tags = all_tags | append: tt | append: '|' -%}{%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- assign tag_list = all_tags | split: '|' | uniq -%}

<!-- Filter tabs -->
<div class="drinks-filter" role="tablist">
  <button class="filter-btn active" data-filter="all" role="tab" aria-selected="true">Tutti</button>
  {%- for tag in tag_list -%}
    {%- if tag != blank -%}
      <button class="filter-btn" data-filter="{{ tag | handleize }}" role="tab" aria-selected="false">{{ tag }}</button>
    {%- endif -%}
  {%- endfor -%}
</div>

<!-- Cocktail grid -->
<div class="cocktail-grid">
  {%- for block in section.blocks -%}
    {%- if block.type == 'cocktail' -%}
      {%- assign card_tags = block.settings.tags | split: ',' -%}
      {%- capture card_slugs -%}{%- for t in card_tags -%}{{ t | strip | handleize }} {% endfor -%}{%- endcapture -%}
      {%- capture card_label -%}{%- for t in card_tags -%}{{ t | strip }}{%- unless forloop.last %} + {% endunless -%}{%- endfor -%}{%- endcapture -%}
      <article class="cocktail-card" data-spirit="{{ card_slugs | strip }}">

        <div class="cocktail-card__image">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 800 | image_tag:
              loading: 'lazy',
              alt: block.settings.name | escape
            }}
          {%- else -%}
            <div class="cocktail-card__image-placeholder">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                <path d="M8 3l4 8 5-5v13H3V6l5 5 4-8z"/>
              </svg>
              <span>Foto cocktail</span>
            </div>
          {%- endif -%}
        </div>

        <div class="cocktail-card__body">
          <p class="cocktail-card__spirit cocktail-card__spirit--{% if card_tags.size == 1 %}{{ card_tags[0] | strip | handleize }}{% else %}multi{% endif %}">{{ card_label }}</p>
          <h3 class="cocktail-card__name">{{ block.settings.name }}</h3>
          {%- if block.settings.description != blank -%}
            <p class="cocktail-card__desc">{{ block.settings.description }}</p>
          {%- endif -%}

          {%- if block.settings.ingredients != blank or block.settings.method != blank -%}
            <button class="recipe-toggle" onclick="toggleRecipe(this)" aria-expanded="false">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 5v14M5 12h14"/>
              </svg>
              <span class="toggle-label">Vedi ricetta</span>
            </button>

            <div class="recipe-body" aria-hidden="true">
              {%- if block.settings.ingredients != blank -%}
                <p class="recipe-section-title">Ingredienti</p>
                <ul class="recipe-ingredients">
                  {%- assign ingredients = block.settings.ingredients | newline_to_br | split: "<br />" -%}
                  {%- for ingredient in ingredients -%}
                    {%- if ingredient != blank -%}
                      <li>{{ ingredient }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.method != blank -%}
                <p class="recipe-section-title">Preparazione</p>
                <p class="recipe-method">{{ block.settings.method | newline_to_br }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

      </article>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
