{%- assign cocktails = shop.metaobjects.cocktail.values -%}

<div class="drinks-hero">
  <p class="eyebrow">Miscelazione</p>
  <h1>{{ section.settings.title }}</h1>
  <p>{{ section.settings.subtitle }}</p>
</div>

{%- comment -%} Filtri: un pulsante per ogni prodotto usato in almeno un cocktail. {%- endcomment -%}
{%- assign seen = '|' -%}
{%- capture filter_buttons -%}
  {%- for c in cocktails -%}
    {%- for p in c.prodotti_usati.value -%}
      {%- assign key = '|' | append: p.handle | append: '|' -%}
      {%- unless seen contains key -%}
        {%- assign seen = seen | append: p.handle | append: '|' -%}
        {%- capture info -%}{%- render 'product-spirit', product: p -%}{%- endcapture -%}
        {%- assign parts = info | split: '::' -%}
        <button class="filter-btn" data-filter="{{ p.handle }}" role="tab" aria-selected="false" style="--spirit-color: {{ parts[1] }};">{{ parts[0] }}</button>
      {%- endunless -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}

<!-- Filter tabs -->
<div class="drinks-filter" role="tablist">
  <button class="filter-btn active" data-filter="all" role="tab" aria-selected="true">Tutti</button>
  {{ filter_buttons }}
</div>

<!-- Cocktail grid -->
<div class="cocktail-grid">
  {%- for c in cocktails -%}
    {%- assign prods = c.prodotti_usati.value -%}
    {%- capture slugs -%}{%- for p in prods -%}{{ p.handle }} {% endfor -%}{%- endcapture -%}
    {%- assign spirit_color = '#CCCCCC' -%}
    {%- capture labels -%}
      {%- for p in prods -%}
        {%- capture info -%}{%- render 'product-spirit', product: p -%}{%- endcapture -%}
        {%- assign parts = info | split: '::' -%}
        {%- if forloop.length == 1 -%}{%- assign spirit_color = parts[1] -%}{%- endif -%}
        <span style="color: {{ parts[1] }};">{{ parts[0] }}</span>{%- unless forloop.last %}<span class="cocktail-card__plus"> + </span>{% endunless -%}
      {%- endfor -%}
    {%- endcapture -%}
    <article class="cocktail-card" data-spirit="{{ slugs | strip }}">

      <div class="cocktail-card__image">
        {%- if c.foto.value != blank -%}
          {{ c.foto.value | image_url: width: 800 | image_tag:
            loading: 'lazy',
            alt: c.foto.value.alt | default: c.nome.value | escape
          }}
        {%- else -%}
          <div class="cocktail-card__image-placeholder">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
              <path d="M8 3l4 8 5-5v13H3V6l5 5 4-8z"/>
            </svg>
            <span>Foto cocktail</span>
          </div>
        {%- endif -%}
      </div>

      <div class="cocktail-card__body">
        <p class="cocktail-card__spirit" style="color: {{ spirit_color }};">{{ labels }}</p>
        <h3 class="cocktail-card__name">{{ c.nome.value }}</h3>
        {%- if c.descrizione_breve.value != blank -%}
          <p class="cocktail-card__desc">{{ c.descrizione_breve.value }}</p>
        {%- endif -%}

        {%- if c.ingredienti.value != blank or c.preparazione.value != blank -%}
          <button class="recipe-toggle" onclick="toggleRecipe(this)" aria-expanded="false">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 5v14M5 12h14"/>
            </svg>
            <span class="toggle-label">Vedi ricetta</span>
          </button>

          <div class="recipe-body" aria-hidden="true">
            {%- if c.ingredienti.value != blank -%}
              <p class="recipe-section-title">Ingredienti</p>
              <ul class="recipe-ingredients">
                {%- assign ingredients = c.ingredienti.value | newline_to_br | split: "<br />" -%}
                {%- for ingredient in ingredients -%}
                  {%- if ingredient != blank -%}
                    <li>{{ ingredient | strip_newlines | strip }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
            {%- if c.preparazione.value != blank -%}
              <p class="recipe-section-title">Preparazione</p>
              <p class="recipe-method">{{ c.preparazione.value | newline_to_br }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

    </article>
  {%- else -%}
    <p style="color:var(--color-gray);grid-column:1/-1;text-align:center;padding:3rem;">Nessun cocktail disponibile al momento.</p>
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Drink List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "default": "Drink List"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sottotitolo",
      "default": "Ricette pensate per esaltare il carattere dei nostri spiriti. Dai classici alle creazioni più originali."
    }
  ],
  "presets": [
    { "name": "Drink List" }
  ]
}
{% endschema %}
