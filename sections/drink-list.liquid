<div class="drinks-hero">
  <p class="eyebrow">Miscelazione</p>
  <h1>{{ section.settings.title }}</h1>
  <p>{{ section.settings.subtitle }}</p>
</div>

<!-- Filter tabs -->
<div class="drinks-filter" role="tablist">
  <button class="filter-btn active" data-filter="all" role="tab" aria-selected="true">Tutti</button>
  <button class="filter-btn" data-filter="gin" role="tab" aria-selected="false">Garnet Gin</button>
  <button class="filter-btn" data-filter="bitter" role="tab" aria-selected="false">Garnet Bitter</button>
</div>

<!-- Cocktail grid -->
<div class="cocktail-grid">
  {%- for block in section.blocks -%}
    {%- if block.type == 'cocktail' -%}
      <article class="cocktail-card" data-spirit="{{ block.settings.spirit }}">

        <div class="cocktail-card__image">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 600 | image_tag:
              loading: 'lazy',
              alt: block.settings.name | escape
            }}
          {%- else -%}
            <div class="cocktail-card__image-placeholder">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true">
                <path d="M8 3l4 8 5-5v13H3V6l5 5 4-8z"/>
              </svg>
              <span>Foto cocktail</span>
            </div>
          {%- endif -%}
        </div>

        <div class="cocktail-card__body">
          <p class="cocktail-card__spirit cocktail-card__spirit--{{ block.settings.spirit }}">
            {%- if block.settings.spirit == 'gin' -%}Garnet Gin{%- else -%}Garnet Bitter{%- endif -%}
          </p>
          <h3 class="cocktail-card__name">{{ block.settings.name }}</h3>
          {%- if block.settings.description != blank -%}
            <p class="cocktail-card__desc">{{ block.settings.description }}</p>
          {%- endif -%}

          {%- if block.settings.ingredients != blank or block.settings.method != blank -%}
            <button class="recipe-toggle" onclick="toggleRecipe(this)" aria-expanded="false">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 5v14M5 12h14"/>
              </svg>
              <span class="toggle-label">Vedi ricetta</span>
            </button>

            <div class="recipe-body" aria-hidden="true">
              {%- if block.settings.ingredients != blank -%}
                <p class="recipe-section-title">Ingredienti</p>
                <ul class="recipe-ingredients">
                  {%- assign ingredients = block.settings.ingredients | split: newline -%}
                  {%- for ingredient in ingredients -%}
                    {%- if ingredient != blank -%}
                      <li>{{ ingredient }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
              {%- if block.settings.method != blank -%}
                <p class="recipe-section-title">Preparazione</p>
                <p class="recipe-method">{{ block.settings.method }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

      </article>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Drink List",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titolo",
      "default": "Drink List"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Sottotitolo",
      "default": "Ricette pensate per esaltare il carattere dei nostri spiriti. Dai classici alle creazioni più originali."
    }
  ],
  "blocks": [
    {
      "type": "cocktail",
      "name": "Cocktail",
      "settings": [
        {
          "type": "select",
          "id": "spirit",
          "label": "Spirito base",
          "options": [
            { "value": "gin", "label": "Garnet Gin" },
            { "value": "bitter", "label": "Garnet Bitter" }
          ],
          "default": "gin"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Foto cocktail"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Nome cocktail"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Descrizione breve"
        },
        {
          "type": "textarea",
          "id": "ingredients",
          "label": "Ingredienti (uno per riga)"
        },
        {
          "type": "textarea",
          "id": "method",
          "label": "Preparazione"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Drink List",
      "blocks": [
        {
          "type": "cocktail",
          "settings": {
            "spirit": "gin",
            "name": "Garnet Tonic",
            "description": "Aromatico · Morbido · Frizzante",
            "ingredients": "5 cl Garnet Gin Almandino\nTonica Indian Taste a colmare\nGhiaccio cube",
            "method": "Bicchiere: Collins\nGarnish: twist di limone e chicchi di melagrana freschi\nTecnica: build and top"
          }
        },
        {
          "type": "cocktail",
          "settings": {
            "spirit": "gin",
            "name": "Almandino",
            "description": "Agrumato · Dolce · Fresco",
            "ingredients": "5 cl Garnet Gin Almandino\n2 cl Triple Sec\n3 cl succo di lime fresco\n1 cl sciroppo di melagrana\n2 dash di foamer",
            "method": "Bicchiere: coppetta\nTecnica: shake and double strain"
          }
        },
        {
          "type": "cocktail",
          "settings": {
            "spirit": "bitter",
            "name": "Garnet Spritz",
            "description": "Speziato · Aromatico · Frizzante",
            "ingredients": "6 cl Garnet Bitter Spessartina\n10 cl Prosecco\nSoda a colmare\nGhiaccio cube",
            "method": "Bicchiere: Collins\nGarnish: twist di limone e arancia\nTecnica: build and top"
          }
        },
        {
          "type": "cocktail",
          "settings": {
            "spirit": "bitter",
            "name": "Garnet Rush",
            "description": "Fresco · Speziato · Rigenerante",
            "ingredients": "5 cl Garnet Bitter Spessartina\nSoda al pompelmo a colmare\nGhiaccio cube",
            "method": "Bicchiere: Collins\nGarnish: chicchi di melagrana freschi\nTecnica: build"
          }
        },
        {
          "type": "cocktail",
          "settings": {
            "spirit": "bitter",
            "name": "Negroni Fashion",
            "description": "Intenso · Amaro",
            "ingredients": "3 cl Garnet Gin Almandino\n4 cl Garnet Bitter Spessartina\n2 cl Vermouth Punt e Mes\nGhiaccio cube",
            "method": "Bicchiere: Old Fashioned\nGarnish: twist di limone e arancia\nTecnica: stir"
          }
        },
        {
          "type": "cocktail",
          "settings": {
            "spirit": "bitter",
            "name": "Americano Spessartina",
            "description": "Aromatico · Morbido",
            "ingredients": "4,5 cl Garnet Bitter Spessartina\n4,5 cl Vermouth Punt e Mes\nSoda a colmare\nGhiaccio cube",
            "method": "Bicchiere: Old Fashioned\nGarnish: twist di limone e arancia\nTecnica: build and top"
          }
        }
      ]
    }
  ]
}
{% endschema %}
