{%- comment -%}
  Pagina wishlist. Il browser salva solo gli ID dei prodotti preferiti (localStorage);
  qui vengono generate le card di tutti i prodotti del negozio e il JS mostra solo quelle salvate.
{%- endcomment -%}

<div class="container" style="padding-top:3rem;padding-bottom:5rem;">
  <p class="eyebrow" style="text-align:center;margin-bottom:.25rem;">La tua lista</p>
  <h1 style="text-align:center;margin-bottom:2.5rem;">Wishlist</h1>

  <div id="wishlist-grid" class="product-grid">
    {%- for product in collections.all.products limit: 50 -%}
      <div class="wishlist-item" data-wishlist-card="{{ product.id }}" hidden>
        {%- render 'product-card', product: product -%}
      </div>
    {%- endfor -%}

    <div id="wishlist-empty" style="grid-column:1/-1;text-align:center;padding:3rem 0;color:var(--color-gray);">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" style="margin-bottom:1rem;opacity:.4;" aria-hidden="true">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
      <p style="margin-bottom:1.5rem;">La tua wishlist è vuota.</p>
      <a href="/collections/all" class="btn btn--outline" style="padding:.7rem 1.5rem;font-size:.78rem;">Scopri i prodotti</a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    if (typeof Wishlist === 'undefined') return;
    var cards = document.querySelectorAll('[data-wishlist-card]');
    var empty = document.getElementById('wishlist-empty');

    function render() {
      var saved = Wishlist.get().map(String);
      var shown = 0;
      cards.forEach(function (c) {
        var on = saved.indexOf(c.getAttribute('data-wishlist-card')) > -1;
        c.hidden = !on;
        if (on) shown++;
      });
      empty.style.display = shown ? 'none' : 'block';
    }

    render();
    // il cuore sulla card toglie il prodotto dalla lista
    document.addEventListener('click', function (e) {
      if (e.target.closest('[data-wishlist-id]')) setTimeout(render, 0);
    });
  });
</script>

{% schema %}
{
  "name": "Wishlist Page",
  "settings": []
}
{% endschema %}
