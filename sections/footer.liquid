<footer class="site-footer" role="contentinfo">

  <!-- Brand column -->
  <div class="site-footer__brand">
    <a href="/" class="site-footer__logo" aria-label="{{ shop.name }} - Home">
      <img
        src="{{ 'garnet-logo.png' | asset_url }}"
        alt="{{ shop.name }}"
        class="site-footer__logo-img"
        width="120"
        loading="lazy">
    </a>
    <p>{{ section.settings.tagline }}</p>
    <p class="site-footer__claim">One sip, one secret.</p>
  </div>

  <!-- Nav column -->
  <div class="site-footer__col">
    <h4>{{ section.settings.nav_title }}</h4>
    {%- for link in linklists['footer'].links -%}
      <a href="{{ link.url }}">{{ link.title }}</a>
    {%- endfor -%}
  </div>

  <!-- Contact column -->
  <div class="site-footer__col">
    <h4>{{ section.settings.contact_title }}</h4>
    {%- if section.settings.email != blank -%}
      {%- comment -%}
        Indirizzo offuscato contro i bot che raccolgono email: nell'HTML non c'è mai "nome@dominio",
        il link mailto viene composto da JavaScript nel browser del visitatore.
      {%- endcomment -%}
      {%- assign email_parts = section.settings.email | split: '@' -%}
      <a href="#" class="js-email" data-u="{{ email_parts[0] }}" data-d="{{ email_parts[1] }}">{{ email_parts[0] }} [at] {{ email_parts[1] }}</a>
    {%- endif -%}
    <a href="{{ section.settings.instagram | default: 'https://www.instagram.com/garnetspirits/' }}" target="_blank" rel="noopener noreferrer">Instagram</a>
    {%- for policy in shop.policies -%}
      <a href="{{ policy.url }}">{{ policy.title }}</a>
    {%- endfor -%}
  </div>

  <!-- Newsletter column -->
  <div class="site-footer__col site-footer__newsletter" id="newsletter">
    <h4>{{ section.settings.newsletter_eyebrow | default: 'Newsletter' }}</h4>
    {%- if section.settings.newsletter_title != blank -%}
      <p class="site-footer__newsletter-title">{{ section.settings.newsletter_title }}</p>
    {%- endif -%}
    {%- if section.settings.newsletter_text != blank -%}
      <p class="site-footer__newsletter-text">{{ section.settings.newsletter_text }}</p>
    {%- endif -%}
    {%- form 'customer', id: 'footer-newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter,footer">
      {%- if form.posted_successfully? -%}
        <p class="site-footer__newsletter-ok">Benvenuto nel mondo Garnet. Ti abbiamo inviato il codice di benvenuto: controlla la tua posta.</p>
      {%- else -%}
        <div class="newsletter-popup__form">
          <input type="email" name="contact[email]" class="newsletter-popup__input"
                 placeholder="La tua email" required autocomplete="email" aria-label="La tua email">
          <button type="submit" class="btn btn--primary" style="padding:.7rem 1.1rem;font-size:.72rem;white-space:nowrap;">Iscriviti</button>
        </div>
        <label class="newsletter-popup__consent">
          <input type="checkbox" name="newsletter_consent" required>
          <span>{{ section.settings.newsletter_consent }} <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}" target="_blank" rel="noopener">Leggi l'informativa privacy</a>.</span>
        </label>
        {%- if form.errors -%}
          <p class="newsletter-popup__error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endif -%}
    {%- endform -%}
  </div>

  <!-- Bottom bar -->
  <div class="site-footer__bottom">
    <span>© {{ 'now' | date: '%Y' }} {{ section.settings.company_name }}{% if section.settings.company_address != blank %} · {{ section.settings.company_address }}{% endif %}{% if section.settings.vat != blank %} · P.IVA e C.F. {{ section.settings.vat }}{% endif %}. Tutti i diritti riservati.</span>
    <span class="site-footer__warning">
      {{ section.settings.alcohol_warning }}
    </span>
  </div>

</footer>

<script>
  document.querySelectorAll('.js-email').forEach(function (a) {
    var e = a.dataset.u + String.fromCharCode(64) + a.dataset.d;
    a.href = 'mailto:' + e;
    a.textContent = e;
  });
</script>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "newsletter_eyebrow",
      "label": "Newsletter: intestazione",
      "default": "Unisciti alla community"
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter: titolo",
      "default": "10% sul tuo primo ordine"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Newsletter: testo",
      "default": "Iscriviti alla newsletter e ricevi il codice di benvenuto, ricette esclusive e anteprime dal mondo Garnet."
    },
    {
      "type": "textarea",
      "id": "newsletter_consent",
      "label": "Newsletter: testo consenso",
      "default": "Ho almeno 18 anni e acconsento a ricevere comunicazioni e offerte via email da Cm2 Spirits Srls. Puoi annullare l'iscrizione in qualsiasi momento."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline brand",
      "default": "Distillati artigianali ispirati alla melagrana e al granato. Nati a Bari nel 2022."
    },
    {
      "type": "text",
      "id": "nav_title",
      "label": "Titolo colonna navigazione",
      "default": "Navigazione"
    },
    {
      "type": "text",
      "id": "contact_title",
      "label": "Titolo colonna contatti",
      "default": "Contatti"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email di contatto",
      "default": "info@garnetspirits.it"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "URL Instagram"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Ragione sociale",
      "default": "Cm2 Spirits Srls"
    },
    {
      "type": "text",
      "id": "company_address",
      "label": "Sede legale",
      "default": "Via Martin Luther King 21, 70124 Bari (BA)"
    },
    {
      "type": "text",
      "id": "vat",
      "label": "Partita IVA",
      "default": "08743730726"
    },
    {
      "type": "text",
      "id": "alcohol_warning",
      "label": "Avvertenza alcol",
      "default": "Bevi responsabilmente. Vietato ai minori di 18 anni. L'abuso di alcol è dannoso per la salute."
    }
  ]
}
{% endschema %}
