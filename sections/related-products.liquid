{%- comment -%}
  Related Products section for product template.
  Shows other products, same kind (spirit/merch) first.
{%- endcomment -%}

{%- capture current_kind -%}{%- render 'product-kind', product: product -%}{%- endcapture -%}
{%- assign related_count = 0 -%}
{%- for p in collections.all.products -%}
  {%- if p.id != product.id -%}
    {%- assign related_count = related_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

{%- if related_count > 0 -%}
<section class="related-products page-wrap" aria-labelledby="related-heading">
  <div class="container">
    <p class="eyebrow" style="text-align:center;margin-bottom:.25rem;">{{ section.settings.eyebrow }}</p>
    <h2 class="related-products__title" id="related-heading" style="text-align:center;margin-bottom:2.5rem;">{{ section.settings.title }}</h2>

    <div class="product-grid">
      {%- assign shown = 0 -%}
      {%- for giro in (1..2) -%}
        {%- for p in collections.all.products -%}
          {%- if p.id != product.id and shown < section.settings.products_to_show -%}
            {%- capture p_kind -%}{%- render 'product-kind', product: p -%}{%- endcapture -%}
            {%- comment -%}Giro 1: stesso genere. Giro 2: l'altro genere.{%- endcomment -%}
            {%- assign show_it = false -%}
            {%- if forloop.parentloop.first -%}
              {%- if p_kind == current_kind -%}{%- assign show_it = true -%}{%- endif -%}
            {%- else -%}
              {%- if p_kind != current_kind -%}{%- assign show_it = true -%}{%- endif -%}
            {%- endif -%}
            {%- if show_it -%}
              {%- render 'product-card', product: p -%}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sopratitolo",
      "default": "Potrebbe interessarti"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titolo sezione",
      "default": "Scopri anche"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Numero prodotti",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    }
  ]
}
{% endschema %}
