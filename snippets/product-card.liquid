{%- comment -%}
  Renders a product card.
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}

{%- capture product_color -%}{%- render 'product-color', product: product -%}{%- endcapture -%}
{%- assign product_color = product_color | strip -%}
{%- assign btn_class = 'btn--product' -%}
{%- comment -%} + Carrello e popup: colore dal metafield custom.colore, altrimenti rosso {%- endcomment -%}
{%- assign cart_color = '#C0392B' -%}
{%- if product.metafields.custom.colore.value != blank -%}
  {%- assign cart_color = product.metafields.custom.colore.value | color_to_hex -%}
{%- endif -%}

{%- assign tag_label = product.metafields.custom.granato.value -%}
{%- capture status -%}{%- render 'product-status', product: product -%}{%- endcapture -%}
{%- assign status = status | strip -%}

<article class="product-card" style="--product-color: {{ product_color }};">

  <!-- Image with overlay actions -->
  <div class="product-card__img-wrap">
    {%- case status -%}
      {%- when 'coming' -%}<span class="sale-badge sale-badge--coming">In arrivo</span>
      {%- when 'soldout' -%}<span class="sale-badge sale-badge--soldout">Esaurito</span>
      {%- when 'sale' -%}<span class="sale-badge">Offerta</span>
      {%- when 'new' -%}<span class="sale-badge sale-badge--new">Novità</span>
    {%- endcase -%}
    <a href="{{ product.url }}" aria-label="{{ product.title }}">
      {%- comment -%}
        Slider immagini: swipe su mobile (scroll-snap), frecce/puntini su desktop.
        Immagini orizzontali: intere (contain) su fondo scuro invece di ritagliate.
      {%- endcomment -%}
      <div class="product-card__image product-card__image--placeholder">
        {%- if product.images.size > 0 -%}
          <div class="product-card__slides" data-card-slides>
            {%- for image in product.images limit: 5 -%}
              {%- assign card_img_alt = image.alt | default: product.title | escape -%}
              <div class="product-card__slide{% if image.aspect_ratio > 1 %} product-card__slide--landscape{% endif %}">
                {{ image | image_url: width: 600 | image_tag: loading: 'lazy', alt: card_img_alt }}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </a>
    {%- if product.images.size > 1 -%}
      {%- assign card_slides = product.images.size | at_most: 5 -%}
      <button type="button" class="product-card__arrow product-card__arrow--prev" data-card-prev aria-label="Immagine precedente">‹</button>
      <button type="button" class="product-card__arrow product-card__arrow--next" data-card-next aria-label="Immagine successiva">›</button>
      <div class="product-card__dots" aria-hidden="true">
        {%- for i in (1..card_slides) -%}
          <span class="product-card__dot{% if forloop.first %} is-active{% endif %}"></span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <!-- Overlay: wishlist + quick add -->
    <div class="product-card__overlay">
      {%- if status == 'coming' or status == 'soldout' -%}
        <a href="/#newsletter" class="product-card__quickadd btn {{ btn_class }}" style="--product-color: {{ cart_color }};"
           aria-label="Avvisami quando {{ product.title | escape }} è disponibile">
          Avvisami
        </a>
      {%- elsif product.available -%}
        <button
          class="product-card__quickadd btn {{ btn_class }}"
          style="--product-color: {{ cart_color }};"
          onclick="QuickAdd.open('{{ product.first_available_variant.id }}', '{{ product.title | escape }}', '{{ product.price | money | escape }}', '{{ cart_color }}')"
          aria-label="Aggiungi rapidamente {{ product.title }} al carrello">
          + Carrello
        </button>
      {%- else -%}
        <span class="product-card__quickadd product-card__soldout btn btn--outline" role="status">Esaurito</span>
      {%- endif -%}
    </div>
  </div>

  <div class="product-card__body">
    {%- if tag_label != blank -%}
      <p class="product-card__tag">{{ tag_label }}</p>
    {%- endif -%}
    <h3 class="product-card__name">
      <a href="{{ product.url }}">{{ product.title }}</a>
    </h3>
    {%- if product.description != blank -%}
      <p class="product-card__desc">
        {{ product.description | strip_html | truncate: 120 }}
      </p>
    {%- endif -%}
    <div class="product-card__footer">
      <span class="product-card__price">
        {{ product.price | money }}
        {%- if product.compare_at_price > product.price -%}
          <s class="price-compare">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
      </span>
      <div class="product-card__actions">
        <button
          type="button"
          class="product-card__heart"
          data-wishlist-id="{{ product.id }}"
          data-wishlist-title="{{ product.title | escape }}"
          aria-label="Aggiungi alla wishlist"
          title="Aggiungi alla wishlist">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
          </svg>
        </button>
        <a href="{{ product.url }}" class="btn btn--outline" style="padding:.55rem 1rem;font-size:.72rem;">
          Scopri →
        </a>
      </div>
    </div>
  </div>
</article>
